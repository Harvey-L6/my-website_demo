# Copy this file to .env.local and fill in your own values.
# 請填入自己的 Notion integration token；勿提交 .env.local。
NOTION_TOKEN=""

# 五個供網站展示使用的 Notion Database ID。
NOTION_PROFILE_DB_ID=""
NOTION_PROJECTS_DB_ID=""
NOTION_CERTIFICATIONS_DB_ID=""
NOTION_SKILLS_DB_ID=""
NOTION_EXPERIENCE_DB_ID=""

# Optional: Vercel normally provides this automatically.
# 如自行填寫，僅填網域，不含 https://；留空時程式以 localhost:3000 為基準。
# VERCEL_PROJECT_PRODUCTION_URL="your-project.vercel.app"
